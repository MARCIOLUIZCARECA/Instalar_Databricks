{
  "datasets": [
    {
      "name": "ds_sales",
      "displayName": "Vendas por loja e dia (Gold)",
      "queryLines": [
        "SELECT store_id, store_name, city, state, region, order_date, total_orders, total_revenue\n",
        "FROM gold_sales_by_store\n"
      ],
      "columns": [
        {
          "displayName": "Faturamento",
          "expression": "SUM(`total_revenue`)",
          "description": "Faturamento (R$) dos pedidos entregues"
        },
        {
          "displayName": "Pedidos",
          "expression": "SUM(`total_orders`)",
          "description": "Pedidos entregues"
        },
        {
          "displayName": "Ticket médio",
          "expression": "SUM(`total_revenue`) / SUM(`total_orders`)",
          "description": "Faturamento / pedidos"
        },
        {
          "displayName": "Lojas",
          "expression": "COUNT(DISTINCT `store_id`)",
          "description": "Lojas com venda no período"
        }
      ]
    }
  ],
  "pages": [
